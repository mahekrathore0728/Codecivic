# CodeCivic Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.

PORT=5000
NODE_ENV=development

# REQUIRED in production — Use a cryptographically strong random string (min 64 chars)
# In development, a fallback is used automatically. In production, the server will NOT start without this.
JWT_SECRET=replace_with_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./server/codecivic.db
UPLOAD_DIR=./server/uploads
MAX_FILE_SIZE_MB=10

# CORS — Comma-separated allowed frontend origins (only enforced in production)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# Rate Limiting
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300

# External Notifications (Optional — system operates fully without these)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_GATEWAY_API_KEY=

# Optional AI Assistance (system operates autonomously using rule-based heuristics if omitted)
AI_API_KEY=
