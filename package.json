{
  "name": "codecivic",
  "version": "1.0.0",
  "description": "CodeCivic: Crowdsourced Civic Issue Reporting and Resolution System",
  "main": "server/src/index.js",
  "scripts": {
    "server": "node server/src/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "seed": "node server/src/seed.js",
    "test": "node server/tests/run_tests.js && node server/tests/e2e_integration_test.js && node server/tests/security_auth_audit_test.js"
  },
  "keywords": [
    "civic-tech",
    "citizen-reporting",
    "governance",
    "issue-tracking"
  ],
  "author": "CodeCivic Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
